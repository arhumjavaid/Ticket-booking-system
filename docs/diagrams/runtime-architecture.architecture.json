  "cards": [
    {
      "dot": "cyan",
      "title": "Primary booking path",
      "items": [
        "Browser \u2192 Nginx \u2192 any of api-1/2/3 \u2192 Booking Service",
        "Redis lock on event:{id}:seat:{id} admits exactly one caller",
        "Postgres transaction re-checks AVAILABLE, then commits"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why no seat is booked twice",
      "items": [
        "The Redis lock rejects losing callers before any DB connection opens",
        "SELECT \u2026 FOR UPDATE is the real guarantee, not the lock",
        "UNIQUE idempotency_key makes a retried request return the original"
      ]
    },
    {
      "dot": "amber",
      "title": "Failure behavior",
      "items": [
        "Any single API instance can die \u2014 Nginx drops it, traffic continues",
        "Redis down: reads fall through to Postgres; booking fails closed",
        "RabbitMQ, OpenSearch or ClickHouse down: booking is unaffected"
      ]
    },
    {
      "dot": "violet",
      "title": "Not drawn as edges",
      "items": [
        "API also uses Redis for cache, rate limits and bloom filters",
        "Prometheus scrapes /metrics on all 8 services; Grafana reads Prometheus",
        "X-Request-ID flows from Nginx through every downstream log line"
      ]
    }
  ]
