{
  "name": "distributed-ticket-booking",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "postinstall": "npm run prisma:generate --workspace=@ticketing/database",
    "build": "npm run build --workspaces --if-present",
    "test:unit": "jest --config tests/jest.unit.config.js",
    "test:integration": "jest --config tests/jest.integration.config.js --runInBand",
    "test:concurrency": "jest --config tests/jest.concurrency.config.js --runInBand",
    "lint": "tsc --build --dry --pretty",
    "migrate": "npm run migrate --workspace=@ticketing/database",
    "seed": "npm run seed --workspace=@ticketing/database"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.11",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "ioredis-mock": "^8.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
