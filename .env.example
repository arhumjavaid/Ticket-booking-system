# ============================================================
# Distributed Ticket Booking System - Environment Configuration
# Copy to .env and adjust as needed. Safe defaults for local
# docker-compose development are already filled in.
# ============================================================

NODE_ENV=development
SERVICE_NAME=api

# ---------- JWT / Auth ----------
JWT_SECRET=dev-super-secret-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---------- PostgreSQL Primary (writes) ----------
DATABASE_URL=postgresql://ticketing:ticketing@postgres-primary:5432/ticketing?schema=public
PRIMARY_DB_HOST=postgres-primary
PRIMARY_DB_PORT=5432
PRIMARY_DB_USER=ticketing
PRIMARY_DB_PASSWORD=ticketing
PRIMARY_DB_NAME=ticketing

# ---------- PostgreSQL Read Replicas (reads) ----------
# Comma-separated list; the app round-robins across them.
REPLICA_DATABASE_URLS=postgresql://ticketing:ticketing@postgres-replica-1:5432/ticketing?schema=public,postgresql://ticketing:ticketing@postgres-replica-2:5432/ticketing?schema=public

# ---------- Sharding (optional, disabled by default) ----------
SHARDING_ENABLED=false
SHARD_COUNT=3
SHARD_0_URL=postgresql://ticketing:ticketing@postgres-primary:5432/ticketing?schema=public
SHARD_1_URL=postgresql://ticketing:ticketing@postgres-shard-1:5432/ticketing?schema=public
SHARD_2_URL=postgresql://ticketing:ticketing@postgres-shard-2:5432/ticketing?schema=public

# ---------- Redis ----------
REDIS_URL=redis://redis:6379
REDIS_LOCK_TTL_MS=10000
SEAT_HOLD_TTL_SECONDS=300

# ---------- RabbitMQ ----------
RABBITMQ_URL=amqp://ticketing:ticketing@rabbitmq:5672
RABBITMQ_EXCHANGE=booking.events

# ---------- OpenSearch ----------
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_EVENTS_INDEX=events

# ---------- ClickHouse ----------
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse

# ---------- API ----------
PORT=3000
API_INSTANCE_ID=api-1
CORS_ORIGIN=http://localhost:5173

# ---------- Booking Service ----------
BOOKING_SERVICE_PORT=4000

# ---------- Worker ----------
WORKER_POLL_INTERVAL_MS=5000

# ---------- Notification / Analytics / Search services ----------
NOTIFICATION_SERVICE_PORT=4100
ANALYTICS_SERVICE_PORT=4200
SEARCH_SERVICE_PORT=4300

# ---------- Rate limiting ----------
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_BROWSE_PER_MIN=100
RATE_LIMIT_BOOKING_PER_MIN=10
RATE_LIMIT_HOLD_PER_MIN=20

# ---------- Observability ----------
LOG_LEVEL=info
METRICS_ENABLED=true
