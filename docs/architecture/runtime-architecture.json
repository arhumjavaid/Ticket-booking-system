  "cards": [
    {
      "dot": "emerald",
      "title": "Primary path: book a seat",
      "items": [
        "Hold → PENDING booking + Stripe PaymentIntent",
        "Signed webhook (via Nginx → API) confirms: seats BOOKED"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Only Nginx is public; Browser and Stripe are untrusted",
        "API verifies JWT; booking-service requires x-internal-token"
      ]
    },
    {
      "dot": "amber",
      "title": "Background & infra",
      "items": [
        "Worker expires holds and reconciles payments",
        "Read models are eventual; Postgres is the source of truth; Prometheus + Grafana scrape all services"
      ]
    }
  ]
